{
  "id": "/",
  "name": "Unishop – Uyo Marketplace",
  "short_name": "Unishop",
  "description": "Shop local finds, book trusted services and discover Uyo businesses on Unishop.",
  "lang": "en-NG",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#fbfbfb",
  "theme_color": "#ffffff",
  "categories": ["shopping", "business", "lifestyle"],
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My workspace", "short_name": "Workspace", "url": "/dashboard.html", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Help", "short_name": "Help", "url": "/help.html", "icons": [{ "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
