JWT_SECRET=replace_with_a_long_random_secret
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=sk_test_replace_with_rotated_test_secret
MARKETPLACE_DATA_PATH=./.data/marketplace.json
# Notifications (all optional; each channel is skipped when unset)
ADMIN_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=Unishop <orders@your-domain.com>
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com
ADMIN_NTFY_TOPIC=

# Automatic NIN verification (Dojah). Without these, NINs stay "pending" for admin review.
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# DOJAH_BASE_URL=https://sandbox.dojah.io

# Public site URL used when building referral links (defaults to the request host)
PUBLIC_URL=
# NIN collection and Dojah verification are off. Set to true to bring them back.
NIN_VERIFICATION_ENABLED=false

# Rider sign-up/sign-in is paused; the admin updates delivery tracking. Set true to bring riders back.
DISPATCH_SIGNIN_ENABLED=false
